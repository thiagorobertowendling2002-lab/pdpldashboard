# Copie este arquivo para .streamlit/secrets.toml (uso local)
# ou cole o conteúdo em "Settings > Secrets" no Streamlit Community Cloud.
#
# NUNCA faça commit do arquivo .streamlit/secrets.toml com senhas reais
# (ele já está no .gitignore).
#
# Gere o hash da senha rodando: python scripts/hash_password.py

[credentials.thiago]
name = "Thiago"
password = "$2b$12$COLE_AQUI_O_HASH_GERADO"

# Adicione quantos usuários confiáveis quiser, um bloco por pessoa:
# [credentials.outrapessoa]
# name = "Nome da Pessoa"
# password = "$2b$12$OUTRO_HASH_AQUI"
